{
  "name": "escape-room-bank-vault-coop",
  "version": "1.0.0",
  "description": "Escape Room Cooperativo en 3D para 2 Jugadores - Antecámara de Bóveda de Banco",
  "main": "server/server.js",
  "type": "module",
  "scripts": {
    "dev:server": "node server/server.js",
    "dev:client": "vite",
    "dev": "concurrently -k -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/server.js",
    "tunnel": "npx cloudflared tunnel --url http://localhost:3001",
    "deploy:cloudflare": "npm run build && npx wrangler deploy"
  },
  "dependencies": {
    "three": "^0.170.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "vite": "^6.0.0"
  }
}
